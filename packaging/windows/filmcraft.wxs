<?xml version="1.0" encoding="utf-8"?>
<!--
  Filme MSI (Suíte FisiLab; based on the FilmCraft MSI) (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build filmcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files\Suite FisiLab\Filme and a Start Menu shortcut. No file associations.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Filme"
      Manufacturer="FisiLab — LARFIC/UFRGS"
      Version="$(var.Version)"
      UpgradeCode="7C1E2A4B-3F5D-4E8A-9B61-0D2F4A6C8E15"
      Scope="perMachine"
      Compressed="yes"
      Language="1046" Codepage="65001">
    <SummaryInformation Description="Filme — Editor de vídeo (Suíte FisiLab)" Manufacturer="FisiLab — LARFIC/UFRGS" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="Uma versão mais nova do Filme já está instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FilmcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="FilmcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/mrcandrade/larfic/tree/main/suite-fisilab" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/mrcandrade/fisilab-filme/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/mrcandrade/fisilab-filme/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="SuiteFisiLabFolder" Name="Suite FisiLab">
        <Directory Id="INSTALLFOLDER" Name="Filme" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Filme" Level="1">
      <ComponentGroupRef Id="FilmcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="FilmcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="FilmcraftApp" Guid="B4D3E2F1-6A7C-4C1E-8F2A-3E5D7B9C1A24">
        <File Id="FilmcraftExe" Source="$(var.BinDir)\fisilab-filme.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Filme"
              Description="Filme — Editor de vídeo" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="FilmcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\fisilab-filme.exe" Value="[#FilmcraftExe]" Type="string" />
      </Component>

      <Component Id="FilmcraftCli">
        <File Id="FilmcraftCliExe" Source="$(var.BinDir)\fisilab-filme-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>

<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>br.ufrgs.fisilab.filme</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Filme</name>
  <summary>Editor de vídeo — Suíte FisiLab (alternativa livre)</summary>
  <developer id="br.ufrgs.fisilab">
    <name>FisiLab — LARFIC</name>
  </developer>
  <description>
    <p>
      O Filme é um editor de vídeo livre e nativo: edição em linha do tempo, correção de cor com
      escopos, efeitos, títulos e legendas, mixagem de áudio e exportação.
    </p>
    <p>
      Baseado no FilmCraft, do ArtCraft Team e contribuidores (MIT ou Apache 2.0).
    </p>
  </description>
  <launchable type="desktop-id">br.ufrgs.fisilab.filme.desktop</launchable>
  <icon type="stock">br.ufrgs.fisilab.filme</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/mrcandrade/larfic</url>
  <url type="bugtracker">https://github.com/mrcandrade/fisilab-filme/issues</url>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>AudioVideoEditing</category>
  </categories>
  <keywords>
    <keyword>video</keyword>
    <keyword>video editor</keyword>
    <keyword>timeline</keyword>
    <keyword>color grading</keyword>
    <keyword>nle</keyword>
    <keyword xml:lang="pt-BR">editor de vídeo</keyword>
    <keyword xml:lang="pt-BR">linha do tempo</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>fisilab-filme</binary>
    <mediatype>application/x-filmcraft</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>

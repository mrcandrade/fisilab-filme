<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>pt-BR</string>
  <key>CFBundleDisplayName</key>
  <string>Filme</string>
  <key>CFBundleName</key>
  <string>Filme</string>
  <key>CFBundleExecutable</key>
  <string>Filme</string>
  <key>CFBundleIdentifier</key>
  <string>br.ufrgs.fisilab.filme</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>FisiLabVersion</key>
  <string>@VERSION@</string>
  <key>FisiLabBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>Filme</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.video</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <!-- Voice-over recording (timeline track header ▸ Voice-over Record) reads the microphone.
       Without this string macOS never asks and the app gets no input. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>O Filme usa o microfone para gravar locução na linha do tempo.</string>
  <key>NSHumanReadableCopyright</key>
  <string>FisiLab (LARFIC/UFRGS) e CTA. Baseado no FilmCraft, do ArtCraft Team e contribuidores. MIT OR Apache-2.0.</string>

  <!-- Finder opens a project by this claim. The exported type alone is not enough:
       without it Launch Services reports that Filme cannot open a FisiLab Filme Project (#1229). -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>FisiLab Filme Project</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>br.ufrgs.fisilab.filme.project</string>
      </array>
    </dict>
  </array>

  <!-- Filme's own format. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>br.ufrgs.fisilab.filme.project</string>
      <key>UTTypeDescription</key>
      <string>FisiLab Filme Project</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.json</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>Filme</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>fcproj</string></array>
        <key>public.mime-type</key>
        <array><string>application/x-filmcraft</string></array>
      </dict>
    </dict>
  </array>

</dict>
</plist>
